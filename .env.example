APP_ENV=production
APP_DEBUG=false
# La radice di ogni collegamento assoluto: email, codici QR, ritorno di Drive
# (app/Support/IndirizzoPubblico.php). Obbligatoria dove si manda posta: dal
# 23/9/2026 senza non c'è ripiego — né sul dominio di un'altra istanza né
# sull'intestazione Host della richiesta — e i flussi che mandano un
# collegamento non partono e registrano l'anomalia indirizzo_pubblico_mancante.
APP_URL=https://www.pantedu.eu
APP_TIMEZONE=Europe/Rome

# ─── Phase S2 Fase 2 — Data dir decoupling ───
# Path assoluto dove l'app cerca i dati (storage/, log/data/, eser/).
# Se vuoto → usa <repo>/storage etc. (backward-compat dev locale).
# In PRODUZIONE consigliato puntare FUORI dal repo per separare codice e dati:
#   PANTEDU_DATA_PATH=/var/lib/pantedu-data
# Layout atteso:
#   {PATH}/storage/verifiche_enc/{tid}/*.bin
#   {PATH}/storage/maps_enc/{tid}/*.bin
#   {PATH}/storage/objects/...
#   {PATH}/storage/data/*.json
#   {PATH}/log/data/*.json
#   {PATH}/eser/*/users/users.json
PANTEDU_DATA_PATH=

# ─── ADR-032 (2026-09-03) — Scenario di esercizio ───
# personal   = 1, uso personale dell'autore: iscrizioni chiuse, nessun account
#              studente (accesso con la credenziale del docente)
# colleagues = 2, colleghi docenti di qualunque scuola: iscrizione docenti
#              aperta con approvazione, nessun account studente
# institute  = 3, adozione da parte di un Istituto (Titolare), con account
#              studente. Richiede INSTANCE_ACN_QUALIFIED=true.
# Vuoto = dedotto da DEPLOYMENT_MODE (institute → 3, single → 1).
# Switch a runtime via /admin/system/deployment (super_admin, con motivazione).
DEPLOYMENT_SCENARIO=
# Dichiarazione di chi conduce l'istanza: infrastruttura qualificata ACN
# (catalogo ACN o infrastruttura dell'Istituto conforme ai livelli minimi).
# Senza, lo scenario 3 non e' attivabile: il Regolamento cloud ACN consente
# alle scuole di avvalersi solo di infrastrutture qualificate.
INSTANCE_ACN_QUALIFIED=false

# Modelli istituzionali risdoc (piano annuale, relazione finale, scheda
# progetto) nel catalogo dei docenti. false = nascosti a tutti gli account
# dell'istanza, autore compreso: gli atti dell'Istituto si redigono e si
# conservano nei suoi sistemi (ToS §2.5). Restano i modelli didattici.
RISDOC_INSTITUTIONAL_TEMPLATES=true

# ─── Phase S2 (ADR-017) — Deployment mode (asse legacy, allineato dallo scenario) ───
# single    = singolo docente (S1, default sicuro, self-signup chiusa)
# institute = scuola multi-docente (S2, registration aperta con admin approve)
# Switch a runtime via /admin/system/deployment (super_admin only).
# Vedi wiki/decisions/ADR-017-deployment-mode-switch.md
DEPLOYMENT_MODE=single
# Email DPO scolastico — usato come contact in privacy notice + breach
# notification SOLO se DEPLOYMENT_MODE=institute. Se vuoto in institute mode,
# fallback su APP_MAIL_FROM.
INSTITUTE_OWNER_EMAIL=
# Ragione sociale scuola — mostrata in footer + DPA + privacy S2.
INSTITUTE_LEGAL_NAME=
# Nome operatore/gestore (data controller) in modo single S1 — mostrato nelle
# trust page (privacy/takedown). Lascia vuoto per etichetta generica.
INSTANCE_OPERATOR_NAME=

SESSION_LIFETIME=1800
# Durata massima di una sessione dal login, in secondi (12 ore). L'id non ruota più
# ogni cinque minuti: cambia a login, secondo fattore e cambio di ruolo.
SESSION_ABSOLUTE_LIFETIME=43200
# Dove stanno le sessioni (ADR-039): file (predefinito) o database. A file la
# cartella è SESSION_SAVE_PATH, o se vuota storage/sessions dei dati d'istanza,
# che sopravvive allo scambio dei container. database non è pronto per la
# produzione: voce 104 del registro del debito.
SESSION_DRIVER=file
SESSION_SAVE_PATH=
SESSION_COOKIE_NAME=PANTEDU_SID
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax

# Gli utenti stanno nel database (tabella users).

CSRF_TOKEN_LIFETIME=7200
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300

# Righe massime tenute in access_log.json (le più vecchie vengono scartate).
# LOG_LEVEL e LOG_RETENTION_DAYS non esistono più: nessun codice le leggeva
# (la retention del log è in app/Config/retention.php).
LOG_MAX_ENTRIES=1000

# Phase 25.C8 — Email outbound (parent_consent + breach + general flows).
# Se APP_MAIL_FROM è vuoto, gli invii email vengono saltati (token + body
# loggati su storage/logs/mail_audit.log per recupero manuale).
#
# Il transport è Resend (RESEND_API_KEY in .env.local): il dominio è
# autenticato lì, quindi APP_MAIL_FROM deve stare sul dominio verificato.
# È una casella send-only — le risposte vanno indirizzate col Reply-To,
# non su questo indirizzo.
APP_MAIL_FROM=operatore@example.net
APP_MAIL_FROM_NAME=Pantedu

# Casella che riceve le notifiche DPO e su cui atterrano le risposte
# all'acknowledgment GDPR (Reply-To). Deve essere una casella LETTA:
# Art. 12 §2 GDPR chiede che l'interessato possa proseguire lo scambio.
# Vuota = CONTACT_EMAIL.
DPO_EMAIL=operatore@example.net

# Le altre caselle dell'istanza (app/Config/mail.php). Dal 23/9/2026 nessuna
# ha un valore scritto nel codice: vuota, una casella ripiega su
# CONTACT_EMAIL; vuota anche quella, quella posta non la riceve nessuno e
# l'applicazione lo dice (nessuna notifica, Reply-To sul mittente, una riga in
# error_log). Devono essere caselle LETTE.
#   CONTACT_EMAIL   contatto generale: risposte alle email di iscrizione,
#                   contatti del modale autore
#   ABUSE_EMAIL     segnalazioni di contenuti (/segnalazione-contenuti) e
#                   contestazioni dell'autore del contenuto (RFC 2142)
#   SECURITY_EMAIL  segnalazioni di vulnerabilità (pagina /security); tieni
#                   allineato il Contact di public/.well-known/security.txt
CONTACT_EMAIL=operatore@example.net
ABUSE_EMAIL=operatore@example.net
SECURITY_EMAIL=operatore@example.net

# Casella che riceve gli avvisi di guasto delle unità systemd
# (`tools/ops/avvisa_guasto.php`, agganciato con `OnFailure=`). Se vuota si
# usa APP_MAIL_FROM, che però è send-only: metterne una vera che qualcuno
# legge, altrimenti l'avviso c'è ma non arriva a nessuno — che è il
# problema che questi avvisi servono a chiudere.
ALERT_EMAIL=

# ─── 2026-09-01 — verifica in due passaggi (2FA TOTP) ───
#
# L'infrastruttura esisteva dal 2026 (migration 055, TotpService) ma nessuno
# la interrogava: chi si iscriveva da /me/2fa si vedeva chiedere solo la
# password al login successivo. Ora AuthController verifica il codice, e
# queste due variabili governano l'obbligo.
#
# SECURITY_TOTP_ENABLED è l'interruttore dell'OBBLIGO: chi ha attivato la
# 2FA per conto proprio se la vede chiedere comunque, anche a false.
# Spegnere l'interruttore non toglie a nessuno una protezione che crede
# attiva — sarebbe lo stesso difetto di prima, al contrario.
# Con dei ruoli elencati qui sotto, però, false NON spegne l'obbligo: fino al
# 23/9/2026 la stringa 'false' si leggeva «acceso», e l'obbligo c'era. La
# contraddizione resta sul lato prudente e finisce nel registro delle
# anomalie; per spegnere l'obbligo si svuota l'elenco dei ruoli, o si decide
# dal pannello /admin/system/deployment.
SECURITY_TOTP_ENABLED=false
#
# Ruoli per cui la 2FA è obbligatoria, separati da virgola. Vuoto = nessuno.
# Chi ha un ruolo elencato e non l'ha ancora attivata viene accompagnato a
# /me/2fa e non può usare il resto finché non completa l'iscrizione.
#   Esempi:  super_admin
#            super_admin,administrator
SECURITY_TOTP_REQUIRED_ROLES=

# ─── 2026-09-01 — recupero password ───
#
# /password/forgot manda un link monouso valido un'ora. Richiede APP_MAIL_FROM
# configurato sopra: senza, il token viene comunque emesso ma l'email non
# parte, e l'utente resta chiuso fuori senza saperlo. La tabella è
# password_resets (migration 095).
#
# Reimpostare la password NON disattiva la 2FA: al login successivo il codice
# viene chiesto lo stesso.

# ─── Phase 25.P — accettazione ToS/AUP ───
# true  = il docente che non ha accettato la versione EFFICACE dei documenti
#         viene rediretto a /tos-acceptance e non può usare l'app.
# false = nessun blocco. Il banner di preavviso e le email restano attivi:
#         disattivare l'enforcement non disattiva l'informazione.
# Le rotte esenti (login, logout, /legal/*, /privacy/*, asset) sono
# elencate in app/Middleware/TosAcceptanceMiddleware.php.
#
# Solo il DEFAULT INIZIALE: normalmente si accende e si spegne dal toggle in
# /admin/system/deployment, che ha effetto immediato e registra in
# privileged_access_log chi l'ha girato e con quale motivazione. L'override
# (storage/config/tos_enforcement.json) ha la precedenza su questa riga.
TOS_ENFORCE=false

# Preavviso minimo per modifiche sostanziali, in giorni. È un impegno preso
# con l'utente in docs/legal/tos_docente.md §8 e docs/legal/aup.md §6:
# abbassarlo richiede prima di modificare quei documenti e ripubblicare i PDF.
LEGAL_NOTICE_DAYS=30

# La versione dell'informativa con cui si archiviano i consensi
# (consents.text_version) non è più configurazione: dal 23/9/2026 è il
# `versione:` del testo servito nello scenario attivo (informativa-personale,
# informativa, informativa-istituto; DeploymentScenario::versioneInformativa).
# GDPR_TEXT_VERSION non si legge più: un numero solo non può valere per tre
# testi, e negli scenari 1 e 3 citava quello sbagliato.

# ─────────────────────────────────────────────────────────────────────
# Phase 25 — security/quality toggles (default = warn/relaxed safe per
# rollout; raccomandato in PRODUZIONE i valori commentati a destra)
# ─────────────────────────────────────────────────────────────────────

# Phase 25.B4 — audit reason header X-Audit-Reason (admin POST/DELETE)
#   enforce: 400 se header mancante o invalido (predefinito dal 23/9/2026,
#            anche per un valore sconosciuto)
#   warn: logga assenza ma procede (il modo del rollout)
#   disabled: skip
# Con APP_ENV=production il container non parte con un valore diverso da
# enforce (docker/verifica-avvio.php, wiki/environment-variables.md).
AUDIT_REASON_MODE=enforce

# Phase 25.B5 — rate-limit bypass (mai abilitare in produzione!)
#   1 = spegne il limitatore delle richieste per rotta (RateLimitMiddleware);
#       NON quelli del login e delle stampe, che hanno il proprio RateLimiter
#   unset/0 = limiti applicati
#   Dove vale 1, e perché: wiki/environment-variables.md, «Dove
#   RATE_LIMIT_DISABLED vale 1» (la regola sta lì sola).
RATE_LIMIT_DISABLED=0                  # PROD recommended: unset (default 0); a 1 (dev) un client puo' comunque
                                       # chiedere il limite con l'header X-Pantedu-Rate-Limit: enforce (spec e2e)

# Phase 25.B6 — Content Security Policy mode (security.csp_mode override)
#   relaxed (default): permette inline scripts legacy (jQuery, Quill, ecc.)
#   strict: blocca inline (richiede cleanup completo, Phase 25.A finale)
#   report-only: monitoring senza enforcement (per tuning pre-strict)
CSP_MODE=relaxed                       # PROD recommended (post cleanup): strict

# Phase 25.D — Crypto envelope (KMS_MASTER in .env.local, non qui!)
#   CRYPTO_DUAL_WRITE=1 → writer plaintext + ciphertext (rollout)
#   CRYPTO_READ_FROM=plaintext|ciphertext (post-backfill: ciphertext)
CRYPTO_DUAL_WRITE=0                    # PROD post-backfill: 1
CRYPTO_READ_FROM=plaintext             # PROD post-backfill: ciphertext

# Phase 25.E4.2 — /metrics Prometheus auth (Bearer token o super_admin session)
METRICS_BEARER_TOKEN=                  # PROD: random 32+ hex generato

# Phase 25.E4.3 — Telemetry span emission (zero overhead se 0)
TELEMETRY_ENABLED=0                    # PROD: 1 se hai pipeline log JSON

# ─────────────────────────────────────────────────────────────────────
# Phase G1 — Google Drive OAuth integration (mappe + risdoc/verifiche
# sync). Credenziali ottenibili in Google Cloud Console:
#   1. Crea progetto + abilita Google Drive API
#   2. APIs & Services > Credentials > Create OAuth client ID (Web app)
#   3. Authorized redirect URIs: <APP_URL>/teacher/drive/callback
# Mantieni client_id/secret in .env.local (NON in .env), perche' .env e'
# committato nel repo.
# ─────────────────────────────────────────────────────────────────────
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=             # Opzionale; se vuoto, derivato da APP_URL
# Drive si offre ai docenti solo con DRIVE_ENABLED=true (ADR-038). Spento, il
# giro notturno esce con zero, e chi ha un collegamento di prima può solo
# scollegarlo. Acceso senza le due credenziali qui sopra è un guasto, e il
# giro lo segnala ogni notte.
DRIVE_ENABLED=false

# ─────────────────────────────────────────────────────────────────────
# Phase G21 — tex-compile-vps (server-side LaTeX compile via VPS dedicato).
# Microservizio HMAC-protected che riceve .tex e ritorna PDF compilato.
# Codice sorgente: tools/tex-compile-vps/
# Deploy:          tools/tex-compile-vps/DEPLOY.md
#
# Se vuoti → integrazione disabilitata (button TEX/PDF salva solo TEX).
# Mantenere il segreto in .env.local (NON in .env committato).
#
# 2026-05-24 — VPS consolidato: il servizio gira sullo STESSO host che serve
# pantedu.eu, senza nginx né TLS. Hostname legacy `tex.pantedu.eu` rimosso dal
# DNS — non riutilizzarlo.
#
# 2026-09-19 — in PROD l'endpoint NON è 127.0.0.1: l'applicazione gira in un
# container, e dal container 127.0.0.1 è il container stesso (undici giorni
# senza compilazioni dal sito, dall'8/9). È il gateway del bridge Docker, che
# vale sia dal container sia dall'host (i lavori a orario):
#   http://<gateway>:8001, con il gateway dato da
#   docker network inspect bridge -f '{{(index .IPAM.Config 0).Gateway}}'
# Il servizio ci deve ascoltare e il firewall lo deve lasciar passare su
# docker0: docs/ops/tex-dal-container.md. Lo controllano GET /health/tex e la
# diagnostica (`tex`).
# In sviluppo (WSL) il servizio locale ascolta su http://127.0.0.1:8001
# (tools/dev/tex-service-local.mjs); vuoto = compilazioni spente.
# ─────────────────────────────────────────────────────────────────────
TEX_COMPILE_ENDPOINT=                  # senza barra finale; in prod il gateway del bridge Docker, vedi sopra
TEX_COMPILE_SECRET=                    # 64-char hex, vedi /opt/tex-compile/.env sul VPS
TEX_COMPILE_TIMEOUT=60                 # secondi, default 60 (margine TikZ)
TEX_COMPILE_ENGINE=pdflatex            # pdflatex|xelatex|lualatex (default pdflatex)
TEX_COMPILE_PASSES=2                   # passate per \ref/\toc (default 2)

# ─────────────────────────────────────────────────────────────────────
# Phase PDF-Import — estrazione esercizi da PDF via LLM vision (PHP-nativo).
# Tool teacher-only su /teacher/pdf-import. Multi-provider; le CHIAVI vivono
# SOLO qui in .env (mai sul client). Disabilitato di default.
# Hardening: budget token/giorno, allowlist Ollama (SSRF), SHA-256 (no MD5).
# ─────────────────────────────────────────────────────────────────────
#
# ATTENZIONE — prima di mettere PDF_IMPORT_ENABLED=true con un provider CLOUD:
#   1. le pagine del PDF escono dall'UE (USA). Vedi docs/legal/dpa_template.md
#      § 7.1-bis (fornitori + basi giuridiche art. 44 GDPR) e il registro
#      art. 30 § B.9. Con un istituto, va notificato al Titolare ex § 7.2.
#   2. `ollama` è l'unico percorso SENZA trasferimenti: nessun sub-responsabile,
#      nessuna SCC, nessun emendamento al DPA. È il default.
#   3. carica SOLO libri di testo, mai elaborati di studenti. La redazione
#      automatica copre codice fiscale ed email, NON i nomi propri.
#      Vedi /legal/ai-literacy.
# Qwen (Alibaba) e OpenRouter sono stati rimossi il 2026-08-26 — vedi la nota
# in app/Services/PdfImport/Provider/ProviderRouter.php.
#   4. serve un rasterizzatore PDF sul server (Imagick con delegate
#      Ghostscript, o `pdftoppm` di poppler-utils): l'immagine del
#      container non ne installa nessuno (D-19). Senza, ogni caricamento
#      risponde 503 (vedi app/Services/PdfImport/PdfRasterizer.php); la
#      pagina mostra già un avviso quando manca. `pdftoppm -v` lo verifica.
PDF_IMPORT_ENABLED=false               # true per abilitare la feature
PDF_IMPORT_DEFAULT_PROVIDER=ollama     # ollama (nessun trasferimento) | anthropic | openai
PDF_IMPORT_MAX_PAGES=40                # cap pagine per sessione
PDF_IMPORT_MAX_PDF_BYTES=26214400      # cap dimensione upload (25 MiB)
PDF_IMPORT_DPI=300                     # risoluzione rasterizzazione PDF→PNG
PDF_IMPORT_PROVIDER_TIMEOUT=90         # timeout HTTP (s) per chiamata vision
PDF_IMPORT_RETENTION_DAYS=7            # TTL: il worker cancella file+righe oltre N giorni
PDF_IMPORT_DAILY_TOKENS=2000000        # budget token/giorno per docente (0=off)
PDF_IMPORT_ANTHROPIC_KEY=              # METTI in .env.local (sk-ant-...)
PDF_IMPORT_ANTHROPIC_MODEL=claude-opus-4-8
PDF_IMPORT_OPENAI_KEY=                 # METTI in .env.local (sk-...)
PDF_IMPORT_OPENAI_MODEL=gpt-4o
PDF_IMPORT_OLLAMA_ENABLED=false        # opt-in: considera Ollama un provider pronto
PDF_IMPORT_OLLAMA_BASE_URL=http://127.0.0.1:11434
PDF_IMPORT_OLLAMA_MODEL=qwen2.5vl:7b
PDF_IMPORT_OLLAMA_ALLOWED_HOSTS=127.0.0.1,localhost  # SSRF allowlist host Ollama
# Le chiavi cloud possono anche essere impostate da UI (popup admin sulla pagina
# /teacher/pdf-import) → salvate in storage/config/pdf_import_keys.json (0600).

# ─────────────────────────────────────────────────────────────────────
# Phase 25.C — WAF self-hosted (GeoIP + Fingerprinting + Scoring + Rules)
# Implementazione: docs/todo/waf_security_prompt.md
# Toggle operativi (enabled, mode, soglie, geo allowed): tabella `waf_config`
# editabile via pannello /admin/waf (super_admin only).
# Qui SOLO i segreti runtime.
# ─────────────────────────────────────────────────────────────────────
# HMAC key per firmare cookie waf_session (>= 32 byte).
# Genera: openssl rand -hex 32. NON committare il valore reale: va in
# .env.local. Senza, app/Config/waf.php ne genera una in storage/keys; con
# APP_ENV=production il container non parte (docker/verifica-avvio.php).
WAF_HMAC_SECRET=
# Path DB GeoIP locale formato .mmdb. Vuoto = no GeoIP DB locale (fallback
# su header CF-IPCountry / X-GeoIP-Country o disable geo).
#
# Opzione A — db-ip.com Lite (NO signup, free monthly, raccomandato):
#   mkdir -p storage/geoip
#   curl -sL "https://download.db-ip.com/free/dbip-country-lite-$(date +%Y-%m).mmdb.gz" \
#     | gunzip > storage/geoip/dbip-country-lite.mmdb
#   WAF_GEOIP_DB=/var/www/pantedu/storage/geoip/dbip-country-lite.mmdb
#
# Opzione B — MaxMind GeoLite2 (signup su maxmind.com + geoipupdate cron):
#   WAF_GEOIP_DB=/etc/GeoIP/GeoLite2-Country.mmdb
# I database GeoIP sono DATI, non codice: vanno sotto PANTEDU_DATA_PATH.
# Puntarli dentro il repository funziona finche' il codice e i dati stanno
# nella stessa cartella; nell'assetto a container no, e il modo in cui si
# rompe e' silenzioso: senza database il paese diventa nullo e il blocco
# geografico smette di bloccare senza dire niente (8 settembre 2026).
#   esempio: WAF_GEOIP_DB=/var/lib/pantedu-data/storage/geoip/dbip-country-lite.mmdb
WAF_GEOIP_DB=

# WAF_GEOIP_ASN_DB — path al .mmdb ASN per enrichment "RDNS & ASN"
# (admin toggle nelle tabelle IP). Free download db-ip.com:
#   curl -sL "https://download.db-ip.com/free/dbip-asn-lite-$(date +%Y-%m).mmdb.gz" \
#     | gunzip > storage/geoip/dbip-asn-lite.mmdb
#   WAF_GEOIP_ASN_DB=/var/www/pantedu/storage/geoip/dbip-asn-lite.mmdb
WAF_GEOIP_ASN_DB=

# BACKUP_DIR — dove `tools/backup/encrypted_backup.sh` mette i salvataggi
# cifrati. Lo legge anche `tools/ops/diagnostica.php` (controllo `lavori`),
# che verifica di trovarci dentro un file recente: un salvataggio che non c'e'
# non si distingue da un salvataggio non ancora servito, ed e' il motivo per
# cui il salvataggio delle chiavi dei docenti e' rimasto fermo tre settimane
# senza che nessuno se ne accorgesse (9 settembre 2026).
# Lasciata vuota vale il predefinito dello script.
BACKUP_DIR=

# ─────────────────────────────────────────────────────────────────────
# Database (MariaDB / MySQL) — credenziali in .env.local (NON qui)
# ─────────────────────────────────────────────────────────────────────
DB_ENABLED=true
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pantedu
DB_USER=pantedu
DB_PASS=                               # METTI in .env.local
DB_CHARSET=utf8mb4
# Connessione via socket Unix invece che host/porta. Vuoto = host/porta.
# Serve nell'assetto a container: MariaDB ascolta solo su loopback, e dentro
# un container `127.0.0.1` e' il container stesso. Il socket si monta in sola
# lettura e non espone il database sulla rete.
#   esempio: DB_SOCKET=/run/mysqld/mysqld.sock
DB_SOCKET=

# ─────────────────────────────────────────────────────────────────────
# Crypto envelope — KMS_MASTER_KEY E STORAGE_SIGNING_SECRET in .env.local!
# Genera entrambi con: openssl rand -hex 32
# IMPORTANTE: perdita di KMS_MASTER_KEY = perdita irreversibile di TUTTI
# i contenuti cifrati. Setup recovery 3-of-5 in
# docs/security/operations/shamir-recovery-runbook.md
# ─────────────────────────────────────────────────────────────────────
KMS_MASTER_KEY=                        # METTI in .env.local (64-hex)
# Solo durante un cambio della chiave master: la chiave nuova, che legge
# soltanto tools/crypto/rewrap_master.php (l'applicazione la ignora). Si
# toglie a cambio finito. Procedura: docs/security/operations/kms-recovery.md
# KMS_MASTER_KEY_NEW=
STORAGE_SIGNING_SECRET=                # METTI in .env.local (64-hex)
ALLOW_CRYPTO_REGENERATE=0              # 1 solo per bypass safeguard (DEV)

# Dev-only: esporre token deletion debug (mai in PROD)
EXPOSE_DELETION_DEBUG_TOKEN=0

# ─────────────────────────────────────────────────────────────────────
# Phase D.2 — SPID + CIE federated identity (disabled fino a AgID SP).
# Vedi docs/plans/d2-spid-cie-integration.md.
# Cert + key in /etc/pantedu/spid/ + /etc/pantedu/cie/ (perm 0600, root)
# NEVER committed.
# ─────────────────────────────────────────────────────────────────────
SPID_ENABLED=0
SPID_SP_ENTITY_ID=https://pantedu.eu/auth/spid/metadata
SPID_SP_CERT_PATH=/etc/pantedu/spid/sp.crt
SPID_SP_KEY_PATH=/etc/pantedu/spid/sp.key
SPID_SP_ORGANIZATION="Pantedu — Piattaforma educativa"
SPID_SP_TECH_CONTACT_EMAIL=operatore@example.net
# Attributi minimi richiesti per docente PA target.
SPID_REQUESTED_ATTRIBUTES=name,familyName,fiscalNumber,dateOfBirth,email
# SPID auth level: 1=basic 2=username+OTP 3=high (smart card)
SPID_REQUESTED_AUTH_LEVEL=2

CIE_ENABLED=0
CIE_SP_ENTITY_ID=https://pantedu.eu/auth/cie/metadata
CIE_SP_CERT_PATH=/etc/pantedu/cie/sp.crt
CIE_SP_KEY_PATH=/etc/pantedu/cie/sp.key
# CIE auth level: L1 = app + CIE PIN, L2 = NFC + PIN, L3 = qual cert
CIE_REQUESTED_AUTH_LEVEL=L2

# ─── Phase Roadmap 9 — Critical CSS opt-in ────────────────────────────
# Inline css/critical.css in <head> + async load main.css. Riduce FCP
# ~1.5s su Slow 3G. Rollback istantaneo cambiando a 0.
# Test su staging prima di abilitare in produzione.
FM_CRITICAL_CSS=0

# (FM_VITALS_ENABLED e FM_HTTP3_ENABLED sono stati tolti il 2026-09-04:
#  nessun codice li leggeva.)

# ─────────────────────────────────────────────────────────────────────
# 2026-09-04 — Chiavi lette dal codice e prima non documentate
# (revisione architetturale, intervento P7). `npm run env:check` verifica
# che ogni variabile letta dal codice compaia in questo file. Le righe
# commentate mostrano il valore predefinito.
# ─────────────────────────────────────────────────────────────────────

# Posta in uscita (app/Config/mail.php). Reply-To degli avvisi di
# aggiornamento delle policy (tools/legal/notify_policy_update.php); vuoto =
# nessun Reply-To. Chiave API Resend per l'invio: vuota = PHP mail().
# APP_MAIL_REPLY_TO=
# RESEND_API_KEY=

# Database: utenti tecnici oltre a DB_USER (tre utenti, vedi
# wiki/architecture). DB_MIGRATOR_* esegue le migrazioni dal deploy (DDL),
# DB_MAINT_* i job pianificati che cancellano le righe scadute. Vuoti = si
# usa la connessione ordinaria. DB_NAME_TEST: database della suite
# (APP_ENV=testing). DB_QUOTA_MB: quota disco mostrata dal monitoraggio.
# DB_MIGRATOR_USER=
# DB_MIGRATOR_PASS=
# DB_MAINT_USER=
# DB_MAINT_PASS=
# DB_NAME_TEST=pantedu_test
# DB_QUOTA_MB=1024

# Storage degli oggetti (app/Config/storage.php): local. Il provider s3 e le
# sue credenziali sono predisposti ma non implementati (S3CompatibleStorageProvider
# lancia a ogni scrittura): con APP_ENV=production il container non parte
# con STORAGE_PROVIDER diverso da local (docker/verifica-avvio.php).
# STORAGE_PROVIDER=local
# STORAGE_S3_ENDPOINT=
# STORAGE_S3_BUCKET=
# STORAGE_S3_REGION=auto
# STORAGE_S3_ACCESS_KEY=
# STORAGE_S3_SECRET=

# WAF e rete (app/Config/waf.php): proxy fidati aggiuntivi (CIDR separati
# da virgola) da cui accettare X-Forwarded-For; bit di difficoltà della
# proof-of-work; bouncer CrowdSec (fail-open se irraggiungibile), acceso solo
# con URL e chiave. L'URL non ha predefinito: dal container 127.0.0.1 è il
# container stesso. Va un indirizzo valido nel container e sull'host, dove
# gira la diagnostica: il gateway del bridge Docker, come per il TeX, non
# host.docker.internal, che l'host non risolve (docs/ops/diagnostica.md,
# «crowdsec»; la diagnostica lo verifica: --solo=crowdsec).
# TRUSTED_PROXIES=
# WAF_POW_BITS=16
# CROWDSEC_LAPI_URL=
# CROWDSEC_LAPI_KEY=

# Sicurezza applicativa (app/Config/security.php)
# SECURITY_HIBP_ENABLED=1     # controllo password compromesse (Have I Been Pwned)
# CSP_REPORT_URI=/api/csp-report   # report-uri della CSP: /api/csp-report e' l'endpoint interno (NDJSON in <logs>/csp-reports); vuoto = nessun report
# XSS_SANITIZE_ENABLED=1      # 0/false/off/no spegne i sanitizer HTML/SVG/TikZ (solo debug)
# RATE_LIMIT_BACKEND=auto     # auto | db | session

# Import PDF, opzioni oltre a quelle sopra (app/Config/pdf_import.php)
# PDF_IMPORT_ASYNC=1                    # estrazione in coda (cron), non nella richiesta
# PDF_IMPORT_PHP_CLI=/usr/bin/php       # binario PHP dei job asincroni
# PDF_IMPORT_NUMBER_SCAN=1
# PDF_IMPORT_AUTO_DIFFICULTY=1
# PDF_IMPORT_AUTO_TOPICS=1
# PDF_IMPORT_AUTO_TRANSLATION=1
# PDF_IMPORT_SOLUTIONS_PER_REQUEST=2
# PDF_IMPORT_RATE_GENERIC=30            # richieste per finestra del rate limit
# PDF_IMPORT_RATE_LLM=12
# Cron dei job (tools/cron/process_pdf_import_jobs.php): lotto per giro,
# giorni prima della pulizia (default: PDF_IMPORT_RETENTION_DAYS), solo pulizia.
# PDF_IMPORT_JOBS_BATCH=3
# PDF_IMPORT_JOBS_PURGE_D=7
# PDF_IMPORT_PURGE_ONLY=0

# Bundle delle CA per le chiamate HTTPS in uscita (servizio TeX, Drive, import
# PDF, HIBP, threat intel, GitHub): App\Support\BundleCa. Vuoto = il bundle di
# sistema di Linux (/etc/ssl/certs/ca-certificates.crt su Debian e
# nell'immagine), e senza quello il bundle di curl. Serve solo per una CA in
# più. Sostituisce TEX_COMPILE_CA_BUNDLE, DRIVE_CA_BUNDLE e
# PDF_IMPORT_CA_BUNDLE, che dal 23/9/2026 non si leggono più.
# CA_BUNDLE=

# Compilazione TeX e TikZ (app/Config/tex_compile.php).
# TIKZ_RENDER_TIMEOUT=25
# TIKZ_RENDER_SVG_MAX=0                 # byte massimi dell'SVG; 0 = default del servizio
# COMPILE_JOBS_BATCH=5                  # tools/cron/process_compile_jobs.php
# COMPILE_JOBS_PURGE_D=7
# DRIVE_CRON_SYNC_OLDER_THAN_H=24       # tools/cron/drive_sync_nightly.php

# GDPR: interruttore della pulizia automatica dei dati scaduti
# (app/Config/retention.php). 0 = i job stampano soltanto (prova a secco).
# GDPR_RETENTION_ENABLED=0

# Sviluppo: asset dal dev server di Vite invece che dal manifest.
# APP_VITE_DEV=0

# Primo super-amministratore (tools/seeds/seed_super_admin.php). La
# password si passa come argomento del comando, non in un file.
# SEED_ADMIN_USERNAME=admin
# SEED_ADMIN_FIRSTNAME=Nome
# SEED_ADMIN_LASTNAME=Cognome
# SEED_ADMIN_EMAIL=admin@example.org
# SEED_ADMIN_PASSWORD=
# SEED_INSTITUTE_CODE=
# SEED_INSTITUTE_NAME=
# SEED_INSTITUTE_CITY=
# SEED_INSTITUTE_REGION=

# Radice del repository per gli strumenti di `tools/curriculum/` quando
# girano da una copia fuori dal repo (per esempio una copia sola caricata sul
# server con PANTEDU_ROOT=/percorso/del/repo). Da dentro il repo non serve.
# PANTEDU_ROOT=
