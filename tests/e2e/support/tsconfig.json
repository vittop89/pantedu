{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "types": ["node"],
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noImplicitOverride": true,
        "noFallthroughCasesInSwitch": true,
        "allowJs": true,
        "checkJs": false,
        "noEmit": true,
        "skipLibCheck": true,
        "resolveJsonModule": true
    },
    "include": [
        "./**/*.ts",
        "../*.spec.js",
        "../*/*.spec.js",
        "../*/*/*.spec.js",
        "../global-setup.js",
        "../../../playwright.config.js"
    ]
}
