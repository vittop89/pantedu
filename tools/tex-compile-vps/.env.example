# tex-compile-vps — environment variables
# Copia in /opt/tex-compile/.env sul VPS e personalizza.

# Segreto HMAC condiviso con il client (hosting legacy). Genera con:
#   openssl rand -hex 32
TEX_COMPILE_SECRET=CHANGE_ME_USE_OPENSSL_RAND_HEX_32

# Dove ascolta il servizio: il gateway del bridge Docker, non 127.0.0.1
# (19/9/2026). L'applicazione gira in un container, e dal container 127.0.0.1
# è il container stesso. Lo legge ExecStart di systemd/tex-compile.service, e
# vuoto il servizio non parte. Si ricava con
#   docker network inspect bridge -f '{{(index .IPAM.Config 0).Gateway}}'
# e lo scrive provision.sh. Solo il valore: niente virgolette, niente commenti
# sulla riga (systemd li prenderebbe come parte dell'indirizzo).
# Perché e come: docs/ops/tex-dal-container.md nel repository dell'applicazione.
TEX_COMPILE_HOST=
# La porta invece è scritta nell'unità (--port 8001): questo valore è solo
# informativo.
TEX_COMPILE_PORT=8001

# Numero massimo di compile concorrenti (semaforo applicativo).
# Adatta in base al numero di vCPU del VPS (consigliato: vCPU - 1).
TEX_COMPILE_MAX_CONCURRENCY=3

# Timeout massimo per singolo compile (secondi).
TEX_COMPILE_TIMEOUT=30

# Tolleranza timestamp HMAC (secondi). Richieste più vecchie scartate.
TEX_COMPILE_MAX_CLOCK_SKEW=300

# Engine LaTeX di default (override per request via campo "engine").
# Valori ammessi: pdflatex, xelatex, lualatex
TEX_COMPILE_DEFAULT_ENGINE=pdflatex

# Numero passate compile per risolvere referenze (\ref, \toc, ecc).
# 2 è standard; portare a 3 se si usa biblatex/biber.
TEX_COMPILE_PASSES=2

# Directory di lavoro per pdflatex (tmpdir per ogni compile).
# IMPORTANTE: deve essere sotto /tmp/ perché il systemd unit usa
# PrivateTmp=yes che rende /tmp e /var/tmp privati al servizio.
# Usare /var/tmp/* richiederebbe ReadWritePaths che entra in conflitto.
TEX_COMPILE_WORKDIR=/tmp/tex-compile

# Log level (DEBUG, INFO, WARNING, ERROR).
TEX_COMPILE_LOG_LEVEL=INFO

# ── Letti dal servizio, con il loro default ────────────────────────────────
# Commentati: senza, vale il default scritto qui, che è quello del codice.
# Elencati dal 23/9/2026: il servizio li leggeva, e questo file non li diceva
# (tools/ci/check-env-servizio-tex.mjs ora lo controlla).
#
# Timeout (secondi) del render TikZ → SVG (app/tikz_render.py).
# TIKZ_RENDER_TIMEOUT=20
# Conversione SVG → PDF (app/svg_render.py): timeout in secondi e risoluzione.
# SVG_TO_PDF_TIMEOUT=10
# SVG_TO_PDF_DPI=96
# Formattazione con latexindent (app/format_tex.py): 1 la spegne; timeout in
# secondi di una formattazione.
# TEX_COMPILE_LATEXINDENT_OFF=
# TEX_COMPILE_LATEXINDENT_TIMEOUT=5
