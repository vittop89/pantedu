[Unit]
Description=pantedu — Export waf_logs blocked entries to file (per fail2ban)
After=network.target mysql.service

# 2026-09-10 — mancava l'avviso di guasto, e non si poteva aggiungerlo prima.
#
# Questa unita' gira **ogni minuto**: un guasto notturno, senza briglia, sono
# quattrocento email prima di colazione. Dal 10 settembre `avvisa_guasto.php`
# ne manda al massimo una per unita' ogni ora e **conta** le altre, dicendo nel
# messaggio successivo quante ne ha ingoiate (App\Support\BrigliaAvvisi).
# Adesso l'avviso si puo' agganciare senza annegare la casella.
OnFailure=pantedu-avviso@%n.service

[Service]
Type=oneshot
User=pantedu
Group=pantedu
WorkingDirectory=/var/www/pantedu
ExecStart=/usr/bin/php /var/www/pantedu/tools/waf/export_blocked_to_log.php
TimeoutStartSec=30

# state file in /var/lib/pantedu deve essere writable
ReadWritePaths=/var/log /var/lib/pantedu

Restart=no
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
