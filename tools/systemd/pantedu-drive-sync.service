[Unit]
# Sincronizzazione notturna con Google Drive.
#
# Per ogni docente che ha collegato Drive e non sincronizza da più di
# ventiquattr'ore, porta le sue mappe concettuali dentro Drive
# (`MapSyncService::syncAllForTeacher`, al massimo 200 file per giro).
#
# Al 9 settembre 2026 il docente collegato è **uno**. Il valore quindi è
# piccolo, ma il costo è ancora più piccolo, e l'alternativa — lasciarlo
# spento — significa che le mappe smettono di sincronizzarsi senza che
# nessuno lo dica. È esattamente la forma di guasto che abbiamo passato la
# notte a togliere di mezzo.
#
# Come per la ripresa delle compilazioni: era una riga nel crontab di un
# utente che non esiste più, quindi non girava dal rinominamento.
Description=pantedu — sincronizzazione notturna delle mappe con Drive
After=network-online.target mariadb.service
Wants=network-online.target

OnFailure=pantedu-avviso@%n.service

[Service]
Type=oneshot
User=pantedu
WorkingDirectory=/var/www/pantedu
ExecStart=/usr/bin/php /var/www/pantedu/tools/cron/drive_sync_nightly.php
# Parla con l'API di Google per ogni docente: mezz'ora è larga per uno solo e
# resta ragionevole se un giorno saranno dieci.
TimeoutStartSec=1800

# ── Contenimento ──────────────────────────────────────────────────────────
#
# Misurato il 9 settembre 2026 con `systemd-analyze security`: tutte le unità
# di questo progetto stavano fra 9.2 e 9.6 su 10, cioè «unsafe» — nessuna
# aveva una sola direttiva di contenimento.
#
# Non è la difesa contro l'intrusione. È la stessa idea del container: dato
# per scontato che prima o poi qualcosa esegua codice non previsto dentro uno
# di questi lavori, quanto lontano arriva?
#
# Sono direttive scelte perché **nessuno di questi programmi ha motivo di fare
# quelle cose**: sono script PHP che leggono un database e scrivono file sotto
# `storage/`. Non caricano moduli del kernel, non toccano l'orologio, non
# hanno bisogno di `/home`, non creano file setuid.
#
# `ProtectSystem=full` e non `strict`: rende `/usr`, `/boot` ed `/etc` in sola
# lettura lasciando `/var` scrivibile, che è dove questi lavori scrivono. Con
# `strict` servirebbe elencare a mano i percorsi di ognuno, e un elenco
# sbagliato si scopre di notte quando il lavoro fallisce.
#
# `NoNewPrivileges` non è compatibile con `sudo`, che è setuid: per questo non
# sta nelle unità che lo usano (il rilascio).
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
