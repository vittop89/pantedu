[Unit]
# 2026-09-02 — anonimizzazione degli account inattivi (art. 5(1)(e) GDPR).
#
# Il job esisteva da Phase 14 ma non era pianificato da nessuna parte, mentre
# informativa, registro art. 30, DPIA e bozza di DPA lo davano per automatico:
# «730 giorni di inattività → anonimizzazione automatica». Con quattro account
# e nessuno vicino alla soglia non c'era ancora sovra-conservazione, ma la
# misura era dichiarata e non operava.
#
# GDPR_RETENTION_ENABLED=1 è obbligatorio: senza, lo script gira in dry-run e
# non scrive nulla. È una scelta dell'autore dello script, e va bene — ma
# significa che pianificarlo senza il flag avrebbe prodotto un timer che non
# anonimizza niente, cioè lo stesso problema con una riga di log in più.
Description=pantedu — anonimizzazione account inattivi (retention GDPR)
After=network-online.target mariadb.service
Wants=network-online.target

# 2026-09-08 — avvisa se fallisce: come sopra: l'anonimizzazione degli account inattivi e' un obbligo,
# non una pulizia.
OnFailure=pantedu-avviso@%n.service

[Service]
Type=oneshot
User=pantedu
WorkingDirectory=/var/www/pantedu
Environment=GDPR_RETENTION_ENABLED=1
ExecStart=/usr/bin/php /var/www/pantedu/tools/gdpr/anonymize_expired.php
TimeoutStartSec=1800

# ── Contenimento ──────────────────────────────────────────────────────────
#
# Misurato il 9 settembre 2026 con `systemd-analyze security`: tutte le unità
# di questo progetto stavano fra 9.2 e 9.6 su 10, cioè «unsafe» — nessuna
# aveva una sola direttiva di contenimento.
#
# Non è la difesa contro l'intrusione. È la stessa idea del container: dato
# per scontato che prima o poi qualcosa esegua codice non previsto dentro uno
# di questi lavori, quanto lontano arriva?
#
# Sono direttive scelte perché **nessuno di questi programmi ha motivo di fare
# quelle cose**: sono script PHP che leggono un database e scrivono file sotto
# `storage/`. Non caricano moduli del kernel, non toccano l'orologio, non
# hanno bisogno di `/home`, non creano file setuid.
#
# `ProtectSystem=full` e non `strict`: rende `/usr`, `/boot` ed `/etc` in sola
# lettura lasciando `/var` scrivibile, che è dove questi lavori scrivono. Con
# `strict` servirebbe elencare a mano i percorsi di ognuno, e un elenco
# sbagliato si scopre di notte quando il lavoro fallisce.
#
# `NoNewPrivileges` non è compatibile con `sudo`, che è setuid: per questo non
# sta nelle unità che lo usano (il rilascio).
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
