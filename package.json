{
  "name": "pantedu",
  "version": "0.4.0",
  "description": "Pantedu — didactic platform (PHP backend + Vite frontend)",
  "license": "EUPL-1.2",
  "homepage": "https://pantedu.eu",
  "author": {
    "name": "{{OPERATORE_NOME}}",
    "email": "vittop89@users.noreply.github.com"
  },
  "bugs": {
    "url": "https://github.com/vittop89/pantedu/issues",
    "email": "vittop89@users.noreply.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vittop89/pantedu.git"
  },
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "vendor:assets": "node tools/build/vendor-assets.mjs",
    "prebuild": "npm run vendor:assets",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:install": "playwright install chromium",
    "e2e:typecheck": "tsc -p tests/e2e/support/tsconfig.json",
    "e2e:a11y": "playwright test tests/e2e/qualita/accessibilita-pubblica.spec.js",
    "e2e:lighthouse": "playwright test tests/e2e/qualita/punteggio-di-accessibilita.spec.js",
    "e2e:visual": "playwright test tests/e2e/qualita/regressione-visiva.spec.js",
    "e2e:visual:update": "playwright test tests/e2e/qualita/regressione-visiva.spec.js --update-snapshots",
    "a11y:all": "npm run e2e:a11y && npm run e2e:lighthouse",
    "env:check": "node tools/ci/check-env-example.mjs",
    "env:tex": "node tools/ci/check-env-servizio-tex.mjs",
    "lint": "eslint --max-warnings=422",
    "lint:fix": "eslint --fix",
    "lint:strict": "eslint --max-warnings=0",
    "audit:js": "npm audit --omit=dev --audit-level=moderate",
    "licenses:js": "npm ls --all --json --omit=dev",
    "moduli:fascio": "node tools/ci/check-moduli-nel-fascio.mjs",
    "bundle:budget": "node tools/ci/bundle-budget.mjs",
    "css:baseline": "node tools/audit/css-baseline.mjs",
    "css:lint": "stylelint \"css/**/*.css\" --max-warnings=0",
    "css:lint:fix": "stylelint \"css/**/*.css\" --fix",
    "css:no-injection": "node tools/ci/no-css-in-js.mjs",
    "csp:no-inline-handlers": "node tools/ci/no-inline-handlers.mjs",
    "legal:versions": "node tools/ci/check-legal-versions.mjs",
    "db:migrations": "node tools/ci/check-migrations-safety.mjs",
    "build:images": "node tools/build/optimize-images.mjs",
    "ci": "npm run css:no-injection && npm run csp:no-inline-handlers && npm run legal:versions && npm run legal:pdf && npm run db:migrations && npm run deploy:units && npm run ci:workflows && npm run meta:letti && npm run percorsi:dati && npm run script:eseguibili && npm run env:check && npm run env:tex && npm run lint && npm run build && npm run moduli:fascio && npm run bundle:budget && npm run audit:js",
    "legal:pdf": "node tools/ci/check-pdf-aggiornati.mjs",
    "deploy:units": "node tools/ci/check-deploy-units.mjs",
    "ci:workflows": "node tools/ci/check-workflows.mjs",
    "meta:letti": "node tools/ci/check-meta-letti.mjs",
    "script:eseguibili": "node tools/ci/check-script-eseguibili.mjs",
    "percorsi:dati": "node tools/ci/no-scritture-nel-repository.mjs"
  },
  "overrides": {
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.59.1",
    "@prettier/plugin-php": "^0.24.0",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^22.20.4",
    "adm-zip": "^0.5.17",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.4",
    "globals": "^15.15.0",
    "happy-dom": "^20.9.0",
    "lighthouse": "^12.8.2",
    "playwright-lighthouse": "^4.0.0",
    "prettier": "^3.8.1",
    "sharp": "^0.34.5",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.8",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.3",
    "@codemirror/legacy-modes": "^6.5.2",
    "@codemirror/lint": "^6.9.5",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.41.1",
    "@mathjax/mathjax-stix2-font": "^4.1.3",
    "@tiptap/core": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "lit": "^3.3.3",
    "mathjax": "^4.1.3",
    "pako": "^2.1.0",
    "pdfjs-dist": "^4.10.38",
    "sortablejs": "^1.15.7"
  }
}
